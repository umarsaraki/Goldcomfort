# Copy this file to `.env` and fill in real values there.
# `.env` must NEVER be committed — it should already be in .gitignore.
# This file (.env.example) is safe to commit: it has no real secrets, only placeholders.

# --- Server ---
# Optional — defaults to 3000 if not set. Most hosts (Render/Railway) set this for you.
PORT=3000

# --- Admin access ---
# Already used by server.js right now: the Google account email allowed to see the Admin Panel.
ADMIN_EMAIL=owner@example.com

# --- Plan length ---
# Already used by server.js right now: how many days a reseller's plan lasts. Defaults to 30.
PLAN_DURATION_DAYS=30

# --- Google Sign-In ("Continue with Google") ---
# Already has a real default baked into server.js — override only if you switch Google projects.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Flutterwave (payments + payouts) ---
# Needed for real checkout and payouts to work.
# From Flutterwave Dashboard > Settings > API Keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# From Flutterwave Dashboard > Settings > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=replace-with-your-webhook-hash

# --- Korapay Identity API (NIN verification) ---
KORAPAY_API_KEY=replace-with-your-korapay-api-key

# --- VTU webhook forwarding ---
VTU_WEBHOOK_FORWARD_URL=https://your-vtu-app.com/path/to/its/webhook

# --- Phone OTP verification (Termii) ---
TERMII_API_KEY=replace-with-your-termii-api-key
TERMII_SENDER_ID=replace-with-your-termii-sender-id
